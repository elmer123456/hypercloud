 export const api = axios.create({ baseURL });
 export const publicApi = axios.create({ baseURL });
 
+// Render's free API can take around a minute to wake after inactivity. Keep
+// vault reads pending and retry transient startup failures instead of showing
+// a false vault error after a short timeout. This runs only for user-triggered
+// reads; it is not a background keepalive.
+const STARTUP_READ_DEADLINE_MS = 75_000;
+const STARTUP_READ_ATTEMPT_TIMEOUT_MS = 20_000;
+
+export async function getWithStartupRetry<T = unknown>(url: string, signal?: AbortSignal) {
+  const deadline = Date.now() + STARTUP_READ_DEADLINE_MS;
+  let attempt = 0;
+
+  while (true) {
+    const remaining = deadline - Date.now();
+    if (remaining <= 0) throw new Error('API_STARTUP_TIMEOUT');
+
+    try {
+      return await api.get<T>(url, {
+        timeout: Math.min(STARTUP_READ_ATTEMPT_TIMEOUT_MS, remaining),
+        signal,
+      });
+    } catch (error) {
+      if (signal?.aborted) throw error;
+      const status = axios.isAxiosError(error) ? error.response?.status : undefined;
+      const transient = axios.isAxiosError(error) &&
+        (!status || status === 408 || status === 429 || status >= 500);
+      const timeLeft = deadline - Date.now();
+      if (!transient || timeLeft <= 0) throw error;
+
+      const delay = Math.min(1_000 * (2 ** Math.min(attempt, 3)), 8_000, timeLeft);
+      await new Promise(resolve => window.setTimeout(resolve, delay));
+      attempt += 1;
+    }
+  }
+}
+
