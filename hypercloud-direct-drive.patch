+    xhr.onload = () => {
+      if (xhr.status === 308) {
+        const match = /bytes=0-(\d+)/i.exec(xhr.getResponseHeader('Range') || '');
+        resolve({ done: false, offset: match ? Number(match[1]) + 1 : null });
+      } else if (xhr.status === 200 || xhr.status === 201) {
+        resolve({ done: true, offset: null });
+      } else {
+        const error: any = new Error(`Google Drive respondió ${xhr.status}: ${xhr.responseText || 'falló la carga'}`);
+        error.response = { status: xhr.status, data: { message: xhr.responseText } };
+        if (xhr.status === 404) error.code = 'DIRECT_SESSION_EXPIRED';
