+function drivePut(url: string, body: Blob | null, contentRange: string, mime: string, onProgress?: (loaded: number) => void): Promise<DrivePutResult> {
+  return new Promise((resolve, reject) => {
+    const xhr = new XMLHttpRequest();
+    xhr.open('PUT', url);
+    xhr.setRequestHeader('Content-Range', contentRange);
+    if (body) xhr.setRequestHeader('Content-Type', mime || 'application/octet-stream');
+    xhr.responseType = 'text';
+    xhr.timeout = 15 * 60 * 1000;
