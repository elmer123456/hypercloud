@@ -0,0 +1,551 @@
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useRef,
+  useState,
+  type FormEvent,
+  type ReactNode,
+} from 'react';
+import { App as NativeApp } from '@capacitor/app';
+import { Capacitor } from '@capacitor/core';
+import { Dialog, DialogPanel, DialogTitle } from '@headlessui/react';
+import { KeyRound, LockKeyhole, ShieldCheck } from 'lucide-react';
+import { api } from '../services/api';
+import { saveOfflineProjectPin } from '../lib/offlineProjects';
+import { revokePinSession } from './PinProtected';
+
+const WEB_LOCK_KEY = 'hc.appLockEnabled';
+const PIN_TOKEN_KEY = 'hypercloud-pin-token';
+const PIN_INPUT = 'focus-neon w-full rounded-xl border border-white/10 bg-white/5 px-3 py-3 text-sm text-white';
+
+type PinStatus = {
+  configured: boolean;
+  migrationRequired?: boolean;
+  recoveryEnabled?: boolean;
+};
+
+type AppLockContextValue = {
+  native: boolean;
+  enabled: boolean;
+  locked: boolean;
+  lockNow: () => void;
+  setWebLockEnabled: (enabled: boolean) => boolean;
+};
+
+const AppLockContext = createContext<AppLockContextValue | null>(null);
+
+function readWebLockEnabled() {
+  try {
+    return localStorage.getItem(WEB_LOCK_KEY) === '1';
+  } catch {
+    return false;
+  }
+}
+
+function pinErrorMessage(error: any) {
+  const code = error?.response?.data?.error;
+  if (code === 'INVALID_PIN') return 'El PIN no coincide. Inténtalo de nuevo.';
+  if (code === 'PIN_TEMPORARILY_LOCKED') return 'Demasiados intentos. Espera 15 minutos y vuelve a intentarlo.';
+  if (code === 'PIN_ALREADY_CONFIGURED') return 'El PIN ya está configurado. Vuelve a intentarlo.';
+  if (code === 'PIN_NOT_CONFIGURED') return 'Primero crea un PIN para tu cuenta.';
+  if (error?.response?.status === 401) return 'La sesión expiró. Vuelve a iniciar sesión.';
+  return 'No se pudo comprobar el PIN. Revisa la conexión y vuelve a intentarlo.';
+}
+
+function LockScreen({
+  status,
+  loading,
+  error,
+  pin,
+  confirmPin,
+  busy,
+  setPin,
+  setConfirmPin,
+  onSubmit,
+  onRetry,
+  native,
+}: {
+  status: PinStatus | null;
+  loading: boolean;
+  error: string;
+  pin: string;
+  confirmPin: string;
+  busy: boolean;
+  setPin: (value: string) => void;
+  setConfirmPin: (value: string) => void;
+  onSubmit: (event: FormEvent<HTMLFormElement>) => void;
+  onRetry: () => void;
+  native: boolean;
+}) {
+  return (
+    <main className="fixed inset-0 z-[100] grid min-h-screen place-items-center overflow-y-auto bg-black px-4 py-8 text-white">
+      <section className="glass w-full max-w-md rounded-2xl p-5 sm:p-7">
+        <div className="flex items-start gap-3">
+          <span className="rounded-xl bg-vault-primary/10 p-3 text-vault-primary">
+            <LockKeyhole size={23} />
+          </span>
+          <div>
+            <h1 className="text-xl font-black">
+              {status?.configured ? 'Desbloquea Hypercloud' : 'Crea el PIN de Hypercloud'}
+            </h1>
+            <p className="mt-1 text-sm text-vault-muted">
+              {native
+                ? 'La APK pide el PIN al abrirse y al volver después de salir de la app.'
+                : 'El bloqueo de este navegador está activado. Se volverá a pedir el PIN al abrir la web o regresar a ella.'}
+            </p>
+          </div>
+        </div>
+
+        {loading ? (
+          <p className="mt-5 text-sm text-vault-muted">Comprobando la seguridad…</p>
+        ) : !status ? (
+          <div className="mt-5 space-y-3">
+            <p role="alert" className="text-sm text-vault-error">{error || 'No se pudo comprobar la seguridad.'}</p>
+            <button
+              type="button"
+              onClick={onRetry}
+              className="min-h-11 w-full rounded-xl border border-white/10 px-4 text-sm hover:border-vault-primary"
+            >
+              Reintentar
+            </button>
+          </div>
+        ) : (
+          <form onSubmit={onSubmit} className="mt-5 space-y-3">
+            <label className="block text-xs text-vault-muted">
+              {status.configured ? 'PIN de Hypercloud' : 'Nuevo PIN (4–12 caracteres)'}
+              <input
+                required
+                autoFocus
+                type="password"
+                autoComplete="off"
+                minLength={4}
+                maxLength={12}
+                value={pin}
+                onChange={event => setPin(event.target.value)}
+                className={`${PIN_INPUT} mt-1`}
+                aria-label="PIN de Hypercloud"
+              />
+            </label>
+            {!status.configured && (
+              <label className="block text-xs text-vault-muted">
+                Confirmar PIN
+                <input
+                  required
+                  type="password"
+                  autoComplete="off"
+                  minLength={4}
+                  maxLength={12}
+                  value={confirmPin}
+                  onChange={event => setConfirmPin(event.target.value)}
+                  className={`${PIN_INPUT} mt-1`}
+                  aria-label="Confirmar PIN"
+                />
+              </label>
+            )}
+            <p className="text-[11px] leading-relaxed text-vault-muted">
+              Se usa el mismo PIN que protege Proyectos, VibeX y Accesos. Tras cinco intentos fallidos, el acceso se pausa temporalmente.
+            </p>
+            {error && <p role="alert" className="text-sm text-vault-error">{error}</p>}
+            <button
+              disabled={busy || pin.length < 4 || (!status.configured && pin !== confirmPin)}
+              className="flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-vault-primary font-bold text-black disabled:opacity-50"
+            >
+              <KeyRound size={16} />
+              {busy ? 'Verificando…' : status.configured ? 'Desbloquear' : 'Guardar PIN y desbloquear'}
+            </button>
+          </form>
+        )}
+      </section>
+    </main>
+  );
+}
+
+export function AppLockGate({ children }: { children: ReactNode }) {
+  const native = Capacitor.isNativePlatform();
+  const [enabled, setEnabled] = useState(() => native || readWebLockEnabled());
+  const [locked, setLocked] = useState(() => native || readWebLockEnabled());
+  const [status, setStatus] = useState<PinStatus | null>(null);
+  const [statusLoading, setStatusLoading] = useState(() => native || readWebLockEnabled());
+  const [statusError, setStatusError] = useState('');
+  const [statusRetry, setStatusRetry] = useState(0);
+  const [pin, setPin] = useState('');
+  const [confirmPin, setConfirmPin] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+  const enabledRef = useRef(enabled);
+  const lockRequest = useRef<Promise<void>>(Promise.resolve());
+
+  enabledRef.current = enabled;
+
+  useEffect(() => {
+    if ((!enabled && !locked) || status) return;
+    let active = true;
+    setStatusLoading(true);
+    setStatusError('');
+    api.get<PinStatus>('/security/pin/status')
+      .then(({ data }) => {
+        if (active) setStatus(data);
+      })
+      .catch((requestError: any) => {
+        if (!active) return;
+        if (requestError?.response?.status === 401) {
+          localStorage.removeItem('token');
+          window.location.assign('/login');
+          return;
+        }
+        setStatusError(pinErrorMessage(requestError));
+      })
+      .finally(() => {
+        if (active) setStatusLoading(false);
+      });
+    return () => { active = false; };
+  }, [enabled, locked, status, statusRetry]);
+
+  const lockNow = useCallback(() => {
+    setLocked(true);
+    setPin('');
+    setConfirmPin('');
+    setError('');
+    lockRequest.current = revokePinSession();
+    window.dispatchEvent(new Event('hypercloud-pin-lock'));
+    if (!status && !statusLoading) {
+      setStatusRetry(value => value + 1);
+    }
+  }, [status, statusLoading]);
+
+  const lockNowRef = useRef(lockNow);
+  lockNowRef.current = lockNow;
+
+  useEffect(() => {
+    const lockOnHide = () => {
+      if (enabledRef.current && document.visibilityState === 'hidden') {
+        lockNowRef.current();
+      }
+    };
+    const lockOnPageHide = () => {
+      if (enabledRef.current) lockNowRef.current();
+    };
+
+    document.addEventListener('visibilitychange', lockOnHide);
+    window.addEventListener('pagehide', lockOnPageHide);
+
+    let active = true;
+    let appStateListener: { remove: () => Promise<void> } | undefined;
+    if (native) {
+      void NativeApp.addListener('appStateChange', state => {
+        if (!state.isActive && enabledRef.current) lockNowRef.current();
+      }).then(listener => {
+        if (active) appStateListener = listener;
+        else void listener.remove();
+      });
+    }
+    return () => {
+      active = false;
+      document.removeEventListener('visibilitychange', lockOnHide);
+      window.removeEventListener('pagehide', lockOnPageHide);
+      if (appStateListener) void appStateListener.remove();
+    };
+  }, [native]);
+
+  const setWebLockEnabled = useCallback((nextEnabled: boolean) => {
+    if (native) return false;
+    try {
+      localStorage.setItem(WEB_LOCK_KEY, nextEnabled ? '1' : '0');
+      enabledRef.current = nextEnabled;
+      setEnabled(nextEnabled);
+      setLocked(false);
+      setPin('');
+      setConfirmPin('');
+      setError('');
+      return true;
+    } catch {
+      return false;
+    }
+  }, [native]);
+
+  async function submitPin(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (!status || pin.length < 4 || pin.length > 12 || /\s/u.test(pin)) {
+      setError('El PIN debe tener entre 4 y 12 caracteres y no contener espacios.');
+      return;
+    }
+    if (!status.configured && pin !== confirmPin) {
+      setError('La confirmación del PIN no coincide.');
+      return;
+    }
+
+    setBusy(true);
+    setError('');
+    try {
+      await lockRequest.current;
+      const { data } = status.configured
+        ? await api.post('/security/pin/verify', { pin })
+        : await api.post('/security/pin/setup', { pin });
+      if (!status.configured) {
+        // Keep the existing encrypted offline-project PIN flow compatible.
+        void saveOfflineProjectPin(pin).catch(() => {});
+      }
+      sessionStorage.setItem(PIN_TOKEN_KEY, data.pinToken);
+      setStatus({ ...status, configured: true });
+      setPin('');
+      setConfirmPin('');
+      setLocked(false);
+    } catch (pinError: any) {
+      if (pinError?.response?.status === 401) {
+        localStorage.removeItem('token');
+        sessionStorage.removeItem(PIN_TOKEN_KEY);
+        window.location.assign('/login');
+        return;
+      }
+      setError(pinErrorMessage(pinError));
+      setPin('');
+      setConfirmPin('');
+      if (pinError?.response?.data?.error === 'PIN_NOT_CONFIGURED') {
+        setStatus({ ...status, configured: false });
+      }
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const context: AppLockContextValue = {
+    native,
+    enabled,
+    locked,
+    lockNow,
+    setWebLockEnabled,
+  };
+
+  return (
+    <AppLockContext.Provider value={context}>
+      {locked ? (
+        <LockScreen
+          status={status}
+          loading={statusLoading}
+          error={statusError || error}
+          pin={pin}
+          confirmPin={confirmPin}
+          busy={busy}
+          setPin={value => { setPin(value); setError(''); }}
+          setConfirmPin={value => { setConfirmPin(value); setError(''); }}
+          onSubmit={submitPin}
+          onRetry={() => {
+            setStatus(null);
+            setStatusError('');
+            setStatusRetry(value => value + 1);
+          }}
+          native={native}
+        />
+      ) : children}
+    </AppLockContext.Provider>
+  );
+}
+
+export function useAppLock() {
+  const value = useContext(AppLockContext);
+  if (!value) throw new Error('useAppLock debe usarse dentro de AppLockGate.');
+  return value;
+}
+
+export function AppLockButton() {
+  const lock = useAppLock();
+  const [open, setOpen] = useState(false);
+  const [status, setStatus] = useState<PinStatus | null>(null);
+  const [statusLoading, setStatusLoading] = useState(false);
+  const [targetEnabled, setTargetEnabled] = useState(false);
+  const [pin, setPin] = useState('');
+  const [confirmPin, setConfirmPin] = useState('');
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [busy, setBusy] = useState(false);
+
+  useEffect(() => {
+    if (!open || lock.native) return;
+    let active = true;
+    setStatusLoading(true);
+    setError('');
+    setNotice('');
+    setPin('');
+    setConfirmPin('');
+    setTargetEnabled(!lock.enabled);
+    api.get<PinStatus>('/security/pin/status')
+      .then(({ data }) => { if (active) setStatus(data); })
+      .catch((requestError: any) => {
+        if (active) setError(pinErrorMessage(requestError));
+      })
+      .finally(() => { if (active) setStatusLoading(false); });
+    return () => { active = false; };
+  }, [open, lock.native, lock.enabled]);
+
+  async function saveWebLock(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (!status) return;
+    if (!status.configured && !targetEnabled) {
+      setError('No hay un PIN configurado para confirmar el cambio.');
+      return;
+    }
+    if (pin.length < 4 || pin.length > 12 || /\s/u.test(pin)) {
+      setError('El PIN debe tener entre 4 y 12 caracteres y no contener espacios.');
+      return;
+    }
+    if (!status.configured && pin !== confirmPin) {
+      setError('La confirmación del PIN no coincide.');
+      return;
+    }
+
+    setBusy(true);
+    setError('');
+    setNotice('');
+    try {
+      if (status.configured) {
+        await api.post('/security/pin/verify', { pin });
+      } else {
+        await api.post('/security/pin/setup', { pin });
+        void saveOfflineProjectPin(pin).catch(() => {});
+        setStatus({ ...status, configured: true });
+      }
+      if (!lock.setWebLockEnabled(targetEnabled)) {
+        throw new Error('No se pudo guardar la preferencia en este navegador.');
+      }
+      setPin('');
+      setConfirmPin('');
+      setNotice(targetEnabled
+        ? 'Bloqueo web activado. Se pedirá el PIN al volver a abrir o retomar este navegador.'
+        : 'Bloqueo web desactivado en este navegador. La APK seguirá solicitando PIN.');
+    } catch (saveError: any) {
+      setError(saveError?.message === 'No se pudo guardar la preferencia en este navegador.'
+        ? saveError.message
+        : pinErrorMessage(saveError));
+      setPin('');
+      setConfirmPin('');
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <>
+      <button
+        type="button"
+        onClick={() => setOpen(true)}
+        aria-label="Configurar bloqueo con PIN"
+        title={lock.native ? 'Bloqueo de la APK' : lock.enabled ? 'Bloqueo web activado' : 'Configurar bloqueo web'}
+        className={`shrink-0 rounded-lg p-1.5 transition hover:bg-white/5 hover:text-vault-primary ${lock.enabled ? 'text-vault-primary' : 'text-vault-muted'}`}
+      >
+        <LockKeyhole size={20} />
+      </button>
+      <Dialog open={open} onClose={() => setOpen(false)} className="relative z-[110]">
+        <div className="fixed inset-0 bg-black/80" aria-hidden="true" />
+        <div className="fixed inset-0 grid place-items-center overflow-y-auto p-4">
+          <DialogPanel className="glass my-4 max-h-[92vh] w-full max-w-md overflow-y-auto rounded-2xl p-5 sm:p-6">
+            <div className="flex items-start gap-3">
+              <span className="rounded-xl bg-vault-primary/10 p-3 text-vault-primary">
+                {lock.native ? <ShieldCheck size={22} /> : <LockKeyhole size={22} />}
+              </span>
+              <div className="min-w-0 flex-1">
+                <DialogTitle className="text-lg font-black">
+                  {lock.native ? 'Seguridad de la APK' : 'Bloqueo con PIN'}
+                </DialogTitle>
+                <p className="mt-1 text-sm text-vault-muted">
+                  {lock.native
+                    ? 'La APK solicita el mismo PIN de Hypercloud al abrirse y al volver después de salir de la app. Esta protección permanece activa.'
+                    : 'Protege esta web en este navegador. Puedes activarlo o desactivarlo cuando quieras; la APK siempre pide el PIN.'}
+                </p>
+              </div>
+              <button
+                type="button"
+                onClick={() => setOpen(false)}
+                aria-label="Cerrar"
+                className="rounded-lg p-2 text-vault-muted hover:bg-white/5"
+              >
+                ×
+              </button>
+            </div>
+
+            {lock.native ? (
+              <div className="mt-5 space-y-3">
+                <button
+                  type="button"
+                  onClick={() => { setOpen(false); lock.lockNow(); }}
+                  className="min-h-11 w-full rounded-xl bg-vault-primary px-4 font-bold text-black"
+                >
+                  Bloquear ahora
+                </button>
+                <p className="text-xs text-vault-muted">El PIN también protege Proyectos, VibeX y Accesos.</p>
+              </div>
+            ) : (
+              <>
+                {statusLoading ? (
+                  <p className="mt-5 text-sm text-vault-muted">Comprobando PIN…</p>
+                ) : !status ? (
+                  <p role="alert" className="mt-5 text-sm text-vault-error">{error || 'No se pudo comprobar el PIN.'}</p>
+                ) : (
+                  <form onSubmit={saveWebLock} className="mt-5 space-y-3">
+                    <p className="rounded-xl border border-white/10 bg-white/5 p-3 text-xs text-vault-muted">
+                      {targetEnabled
+                        ? 'Para activar el bloqueo, confirma tu PIN actual.'
+                        : 'Para desactivar el bloqueo, confirma tu PIN actual.'}
+                    </p>
+                    <label className="block text-xs text-vault-muted">
+                      {status.configured ? 'PIN actual' : 'Crea un PIN (4–12 caracteres)'}
+                      <input
+                        required
+                        autoFocus
+                        type="password"
+                        autoComplete="off"
+                        minLength={4}
+                        maxLength={12}
+                        value={pin}
+                        onChange={event => { setPin(event.target.value); setError(''); }}
+                        className={`${PIN_INPUT} mt-1`}
+                        aria-label={status.configured ? 'PIN actual' : 'Crea un PIN'}
+                      />
+                    </label>
+                    {!status.configured && (
+                      <label className="block text-xs text-vault-muted">
+                        Confirmar PIN
+                        <input
+                          required
+                          type="password"
+                          autoComplete="off"
+                          minLength={4}
+                          maxLength={12}
+                          value={confirmPin}
+                          onChange={event => { setConfirmPin(event.target.value); setError(''); }}
+                          className={`${PIN_INPUT} mt-1`}
+                          aria-label="Confirmar PIN"
+                        />
+                      </label>
+                    )}
+                    {error && <p role="alert" className="text-sm text-vault-error">{error}</p>}
+                    {notice && <p role="status" className="text-sm text-vault-primary">{notice}</p>}
+                    <button
+                      disabled={busy || pin.length < 4 || (!status.configured && pin !== confirmPin)}
+                      className="flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-vault-primary font-bold text-black disabled:opacity-50"
+                    >
+                      <KeyRound size={16} />
+                      {busy ? 'Guardando…' : targetEnabled ? 'Activar bloqueo web' : 'Desactivar bloqueo web'}
+                    </button>
+                  </form>
+                )}
+                <button
+                  type="button"
+                  disabled={!status?.configured}
+                  onClick={() => { setOpen(false); lock.lockNow(); }}
+                  className="mt-3 min-h-10 w-full rounded-xl border border-white/10 px-4 text-sm hover:border-vault-primary disabled:opacity-40"
+                >
+                  Bloquear ahora
+                </button>
+                <p className="mt-3 text-[11px] leading-relaxed text-vault-muted">
+                  Esta preferencia se guarda solo en este navegador. El PIN se valida con el mismo control de intentos de Hypercloud.
+                </p>
+              </>
+            )}
+          </DialogPanel>
+        </div>
+      </Dialog>
+    </>
+  );
+}
