+import { Readable } from 'node:stream';
+import { prisma } from '../lib.js';
+import { driverFor } from './providers/index.js';
+import type { FileRef, StreamResult } from './providers/common.js';
+import { parseRange } from './providers/common.js';
+
+export const VIRTUAL_STORAGE_PREFIX = 'hcparts:v1:';
+export const INTERNAL_PART_PREFIX = '.hcloud-part-';
+
+export type VirtualStoragePart = {
+  accountId: string;
+  drimeFileId: string;
+  downloadUrl: string | null;
+  fileName: string;
+  offset: number;
+  size: number;
+};
+
+export type VirtualStorageManifest = {
+  version: 1;
+  totalSize: number;
+  parts: VirtualStoragePart[];
+};
+
+export function isVirtualStorage(value: string | null | undefined): boolean {
+  return typeof value === 'string' && value.startsWith(VIRTUAL_STORAGE_PREFIX);
+}
+
+export function isInternalStorageObject(name: string | null | undefined): boolean {
+  return typeof name === 'string' && name.startsWith(INTERNAL_PART_PREFIX);
+}
+
+export function encodeVirtualStorage(manifest: VirtualStorageManifest): string {
+  return VIRTUAL_STORAGE_PREFIX + Buffer.from(JSON.stringify(manifest)).toString('base64url');
+}
+
+export function decodeVirtualStorage(value: string): VirtualStorageManifest {
+  if (!isVirtualStorage(value)) throw new Error('NOT_VIRTUAL_STORAGE');
+  const manifest = JSON.parse(Buffer.from(value.slice(VIRTUAL_STORAGE_PREFIX.length), 'base64url').toString('utf8')) as VirtualStorageManifest;
+  if (manifest.version !== 1 || !Number.isSafeInteger(manifest.totalSize) || manifest.totalSize < 0 || !Array.isArray(manifest.parts)) {
+    throw new Error('INVALID_VIRTUAL_STORAGE_MANIFEST');
+  }
+  let offset = 0;
+  for (const part of manifest.parts) {
+    if (!part.accountId || !part.drimeFileId || !Number.isSafeInteger(part.offset) || !Number.isSafeInteger(part.size) || part.size <= 0 || part.offset !== offset) {
+      throw new Error('INVALID_VIRTUAL_STORAGE_PART');
+    }
+    offset += part.size;
+  }
+  if (offset !== manifest.totalSize) throw new Error('INCOMPLETE_VIRTUAL_STORAGE_MANIFEST');
+  return manifest;
+}
+
+export async function streamVirtualStorage(
+  value: string,
+  ownerId: string,
+  file: { size: bigint; mimeType: string | null },
+  rangeHeader?: string,
+): Promise<StreamResult> {
+  const manifest = decodeVirtualStorage(value);
+  const size = Number(file.size);
+  if (!Number.isSafeInteger(size) || size !== manifest.totalSize) throw new Error('VIRTUAL_STORAGE_SIZE_MISMATCH');
+
+  const requested = rangeHeader ? parseRange(rangeHeader, size) : null;
+  if (rangeHeader && !requested) {
+    return {
+      status: 416,
+      headers: { 'content-range': `bytes */${size}`, 'content-length': '0', 'accept-ranges': 'bytes' },
+      data: Readable.from([]),
+    };
+  }
+  const start = requested?.start ?? 0;
+  const end = requested?.end ?? Math.max(0, size - 1);
+  const accountIds = [...new Set(manifest.parts.map(part => part.accountId))];
+  const accounts = await prisma.drimeAccount.findMany({ where: { id: { in: accountIds }, userId: ownerId } });
+  const accountMap = new Map(accounts.map(account => [account.id, account]));
+  if (accountMap.size !== accountIds.length) throw new Error('VIRTUAL_STORAGE_ACCOUNT_MISSING');
+
+  const data = Readable.from((async function* () {
+    for (const part of manifest.parts) {
+      const partEnd = part.offset + part.size - 1;
+      const from = Math.max(start, part.offset);
+      const to = Math.min(end, partEnd);
+      if (from > to) continue;
+
+      const account = accountMap.get(part.accountId)!;
+      const client = driverFor(account);
+      const ref: FileRef = {
+        drimeFileId: part.drimeFileId,
+        downloadUrl: part.downloadUrl,
+        mimeType: file.mimeType,
+        fileName: part.fileName,
+        size: BigInt(part.size),
+      };
+      const localStart = from - part.offset;
+      const localEnd = to - part.offset;
+      const remote = await client.stream(ref, `bytes=${localStart}-${localEnd}`);
+      if (remote.status >= 400) {
+        remote.data.destroy();
+        throw Object.assign(new Error('VIRTUAL_STORAGE_PART_UNAVAILABLE'), { status: remote.status });
+      }
+
+      // Some providers honor Range and return 206; if one ignores it, discard
+      // the leading bytes locally while still emitting exactly the requested range.
+      let skip = remote.status === 206 || remote.headers['content-range'] ? 0 : localStart;
+      let remaining = to - from + 1;
+      try {
+        for await (const raw of remote.data) {
+          const chunk = Buffer.isBuffer(raw) ? raw : Buffer.from(raw);
+          if (skip >= chunk.length) {
+            skip -= chunk.length;
+            continue;
+          }
+          const output = chunk.subarray(skip, Math.min(chunk.length, skip + remaining));
+          skip = 0;
+          if (output.length) {
+            remaining -= output.length;
+            yield output;
+          }
+          if (remaining <= 0) {
+            remote.data.destroy();
+            break;
+          }
+        }
+      } finally {
+        remote.data.destroy();
+      }
+      if (remaining > 0) throw new Error('VIRTUAL_STORAGE_PART_TRUNCATED');
+    }
+  })(), { objectMode: false });
+
+  const length = requested ? requested.end - requested.start + 1 : size;
+  return {
+    status: requested ? 206 : 200,
+    headers: {
+      'content-type': file.mimeType || 'application/octet-stream',
+      'content-length': String(length),
+      'accept-ranges': 'bytes',
+      ...(requested ? { 'content-range': `bytes ${requested.start}-${requested.end}/${size}` } : {}),
+    },
+    data,
+  };
+}
+
+export async function deleteVirtualStorage(value: string, ownerId: string): Promise<void> {
+  const manifest = decodeVirtualStorage(value);
+  const accountIds = [...new Set(manifest.parts.map(part => part.accountId))];
+  const accounts = await prisma.drimeAccount.findMany({ where: { id: { in: accountIds }, userId: ownerId } });
+  const accountMap = new Map(accounts.map(account => [account.id, account]));
+  for (const part of manifest.parts) {
+    const account = accountMap.get(part.accountId);
+    if (!account) continue;
+    try {
+      await driverFor(account).remove(part.drimeFileId, false, true);
+    } catch (error: any) {
+      // Continue removing the remaining pieces; a later account sync can clean
+      // up an orphan if one provider is temporarily unavailable.
+      console.warn('virtual storage cleanup', part.accountId, error?.message || error);
+    }
+  }
+}
